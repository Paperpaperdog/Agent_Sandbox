# Grid'5000 Agent Substrate deployment settings.
# Copy to config.env and adjust hosts/IPs for the current reservation.

# Optional: absolute path to the Agent Substrate git checkout.
# Leave empty when this directory lives inside the substrate repo as
# deploy-grid5000/ (REPO_ROOT becomes the parent directory).
SUBSTRATE_REPO_ROOT=/root/sandbox-platforms/substrate

CONTROL_PLANE_HOST=paradoxe-40.rennes.grid5000.fr
CONTROL_PLANE_IP=172.16.101.40
WORKER_HOSTS="paradoxe-41.rennes.grid5000.fr"
KUBECONFIG=/etc/kubernetes/admin.conf

DATA_ROOT=/tmp/agent-substrate-data
POSTGRES_SIZE=20Gi
RUSTFS_SIZE=50Gi
REGISTRY_ENDPOINT=172.16.101.40:5000
KO_REPOSITORY=172.16.101.40:5000/substrate
CONFIGURE_WORKERS_OVER_SSH=false

KUBE_CONTEXT=kubernetes-admin@kubernetes
ROLLOUT_TIMEOUT=5m
SANDBOX_CLASSES=gvisor
ATENET_DATAPLANE=agentgateway

INSTALL_COUNTER_DEMO=true
VERIFY_ACTOR_LIFECYCLE=true
VERIFY_ACTOR_NAME=grid5000-counter-check
